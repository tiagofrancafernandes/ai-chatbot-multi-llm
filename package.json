{
    "name": "ai-chatbot-multi-llm",
    "version": "1.0.0",
    "description": "Multi-LLM Chatbot with NestJS backend, Vue 3 frontend and Intent Flow Engine",
    "private": true,
    "scripts": {
        "dev": "pnpm --parallel --filter backend --filter frontend dev",
        "dev:backend": "pnpm --filter backend start:dev",
        "dev:frontend": "pnpm --filter frontend dev",
        "build": "pnpm --recursive run build",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [],
    "author": "Tiago França",
    "license": "MIT",
    "devDependencies": {
        "prettier": "^3.9.10"
    }
}
