# Application Ports
BACKEND_PORT=3001
FRONTEND_PORT=5174
VITE_API_URL=http://localhost:3001/api

# Default Active Provider and Model Configuration
# Options: ollama | gemini | openai | lmstudio
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=tev1:0.8b
ENABLED_PROVIDERS=ollama,gemini

# Ollama Configuration (Local / Container)
# Linux host from container: http://host.docker.internal:11434 or http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_DECISION_MODEL=tev1:0.8b
OLLAMA_FALLBACK_MODEL=qwen2.5:0.5b
OLLAMA_CHAT_MODEL=llama3.2:1b

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# LM Studio Configuration (Optional)
LMSTUDIO_HOST=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# JSON Database File Path (Ignored by Git)
DATABASE_FILE_PATH=./data/db.json
