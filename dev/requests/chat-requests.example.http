######### [VARS] #################################
@BASE_URL=http://localhost:3001
@CUSTOMER_REF_TYPE=phone
@CUSTOMER_REF=5511999999999
@CUSTOMER_CPF=123.456.789-00
@GUEST_CUSTOMER_ID=guest_{{$timestamp}}
@AUTH_TOKEN=dev-bearer-token-example
######### [END VARS] #################################

### 1. List Active LLM Providers
# @name listProviders
GET {{BASE_URL}}/api/chat/providers
Accept: application/json

### 2. Switch Active Provider to Ollama (tev1:0.8b decision model)
# @name switchToOllama
POST {{BASE_URL}}/api/chat/providers/switch
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "providerId": "ollama",
    "model": "tev1:0.8b"
}

### 3. Switch Active Provider to Gemini (gemini-3.5-flash-lite)
# @name switchToGemini
POST {{BASE_URL}}/api/chat/providers/switch
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "providerId": "gemini",
    "model": "gemini-3.5-flash-lite"
}

### 4. Initialize Chat Session for Guest (Unidentified Customer)
# @name initGuestChat
POST {{BASE_URL}}/api/chat/init
Accept: application/json
Content-Type: application/json

{
    "customerId": "{{GUEST_CUSTOMER_ID}}"
}

### 5. Initialize or Resume Chat Session for Identified Customer
# @name initIdentifiedChat
POST {{BASE_URL}}/api/chat/init
Accept: application/json
Content-Type: application/json

{
    "customerId": "{{CUSTOMER_REF}}"
}

### 6. Send Message - Greeting Intent
# @name sendGreeting
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "customerId": "{{CUSTOMER_REF}}",
    "text": "Olá, bom dia!",
    "providerId": "ollama",
    "model": "tev1:0.8b"
}

### 7. Send Message - Complex Intent (Technical Support + Invoice Request Auto-Trigger)
# @name sendSupportWithInvoiceRequest
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "customerId": "{{CUSTOMER_REF}}",
    "text": "O sistema caiu de novo. Aproveitando, vocês podem me mandar a segunda via da fatura deste mês?",
    "providerId": "ollama",
    "model": "tev1:0.8b"
}

### 8. Send Message - Plan Pricing Inquiry
# @name sendPricingInquiry
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json

{
    "customerId": "{{CUSTOMER_REF}}",
    "text": "Quais são os planos e preços disponíveis para upgrade?"
}

### 9. Send Message - Financial Overview & Invoices Request
# @name sendFinancialInquiry
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json

{
    "customerId": "{{CUSTOMER_REF}}",
    "text": "Gostaria de consultar minhas faturas e extrato financeiro."
}

### 10. Send Message - Guest Customer Providing Phone Authentication
# @name sendGuestPhoneAuthentication
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json

{
    "customerId": "{{GUEST_CUSTOMER_ID}}",
    "text": "Meu telefone cadastrado é {{CUSTOMER_REF}}"
}

### 11. Send Message - Guest Customer Providing CPF Authentication
# @name sendGuestCpfAuthentication
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json

{
    "customerId": "{{GUEST_CUSTOMER_ID}}",
    "text": "Meu CPF cadastrado é {{CUSTOMER_CPF}}"
}

### 12. Get Chat Session History
# @name getChatHistory
GET {{BASE_URL}}/api/chat/history?customerId={{CUSTOMER_REF}}
Accept: application/json

### 13. Reset Customer Chat Session Cache
# @name resetChatSession
POST {{BASE_URL}}/api/chat/reset
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "customerId": "{{CUSTOMER_REF}}"
}

### 14. Send Message - Plan Consultation
# @name sendPlanConsultation
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "customerId": "{{CUSTOMER_REF}}",
    "text": "Qual é o meu plano atual?"
}

### 15. Send Message - Plan Change Request (Target: Mais barato -> Starter)
# @name sendPlanChangeRequest
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "customerId": "{{CUSTOMER_REF}}",
    "text": "Quero mudar para o plano mais barato"
}

### 16. Send Message - Affirmative Confirmation for Plan Change
# @name sendConfirmPlanChange
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "customerId": "{{CUSTOMER_REF}}",
    "text": "Sim, confirmo a mudança"
}

### 17. Send Message - Address Change Request
# @name sendAddressChangeRequest
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "customerId": "{{CUSTOMER_REF}}",
    "text": "Mudei de casa para Rua das Acácias, 450"
}

### 18. Send Message - Confirm Address Change
# @name sendConfirmAddressChange
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "customerId": "{{CUSTOMER_REF}}",
    "text": "Sim, confirmar endereço"
}

### 19. Send Message - Informal / Slang Technical Support (Handled with high confidence)
# @name sendInformalSupport
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "customerId": "{{CUSTOMER_REF}}",
    "text": "e ae meu bom, o modem ta piscano vermelho e nao entra net"
}

### 20. Send Message - Out of Flow Request (Fallback with smart alternative options)
# @name sendOutOfFlowFallback
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "customerId": "{{CUSTOMER_REF}}",
    "text": "vocês vendem pão de queijo quentinho?"
}

### 21. Guest Registration Flow - Step 1: Start Registration Directly
# @name guestRegistrationRequest
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json

{
    "customerId": "{{GUEST_CUSTOMER_ID}}",
    "text": "Quero me registrar"
}

### 22. Guest Registration Flow - Step 2: Choose Plan Professional
# @name guestChoosePlanPro
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json

{
    "customerId": "{{GUEST_CUSTOMER_ID}}",
    "text": "Quero o plano professional"
}

### 23. Guest Subscription Flow - Step 3: Send Complete Registration Data
# @name guestSendRegistration
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json

{
    "customerId": "{{GUEST_CUSTOMER_ID}}",
    "text": "Carlos Silva, CPF 123.456.789-00, carlos@example.com, 5511988887777, Rua das Flores, 120"
}

### 24. Guest Subscription Flow - Step 4: Check Signature when Still Pending (System alerts user)
# @name guestCheckPendingSignature
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json

{
    "customerId": "{{GUEST_CUSTOMER_ID}}",
    "text": "Já assinei o contrato"
}

### 25. Digital Signature Platform - REST API to Simulate Signing Contract
# @name apiSignContract
POST {{BASE_URL}}/api/chat/contract/sign/CONT-729066
Accept: application/json
Authorization: Bearer {{AUTH_TOKEN}}

### 26. Digital Signature Platform - REST API to Query Contract Status
# @name apiGetContract
GET {{BASE_URL}}/api/chat/contract/CONT-729066
Accept: application/json

### 27. Guest Subscription Flow - Step 5: Inform Signed After Real/Simulated Signature (Activates Account)
# @name guestConfirmSignature
POST {{BASE_URL}}/api/chat/message
Accept: application/json
Content-Type: application/json

{
    "customerId": "{{GUEST_CUSTOMER_ID}}",
    "text": "Simular assinatura do contrato"
}



